# Copy to .env (gitignored) and fill in. Never commit real keys.

# Deepgram — Aura-2 TTS (voice `vesta`) + Nova-3 STT with word timestamps.
# Drives docs/preview-review/gen-voiceover.py. https://developers.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# Gemini — the "meaning" half of refs/analyse.py (rule P review pass).
# Several keys allowed: GEMINI_API_KEY, GEMINI_API_KEY_2, ...
# (Also read from ~/.config/gemini/.env if that file exists.)
GEMINI_API_KEY=

# Optional — ElevenLabs VO (alternative narrator).
ELEVENLABS_API_KEY=
