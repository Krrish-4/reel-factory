  "transcript": [
    {
      "approx_t": 0.0,
      "text": "Think your lips are too thin?"
    },
    {
      "approx_t": 1.0,
      "text": "This is the mouth you're picturing."
    },
    {
      "approx_t": 3.0,
      "text": "And it was never about size."
    },
    {
      "approx_t": 5.0,
      "text": "Lips are not a feature."
    },
    {
      "approx_t": 7.0,
      "text": "They are the line the lower face is measured from."
    },
    {
      "approx_t": 11.0,
      "text": "Your eye never measures a feature alone."
    },
    {
      "approx_t": 15.0,
      "text": "It measures the gaps around it."
    },
    {
      "approx_t": 18.0,
      "text": "Move the lip line and every gap moves."
    },
    {
      "approx_t": 23.0,
      "text": "One. The gap between nose and lip."
    },
    {
      "approx_t": 27.0,
      "text": "Full lips make it short. Thin lips, long."
    },
    {
      "approx_t": 31.0,
      "text": "The nose isn't what changed."
    },
    {
      "approx_t": 33.0,
      "text": "Two. The chin reads stronger."
    },
    {
      "approx_t": 35.0,
      "text": "The chin isn't what changed either."
    },
    {
      "approx_t": 37.0,
      "text": "Here is that range, on one face."
    },
    {
      "approx_t": 41.0,
      "text": "Watch the gap, not the lips."
    },
    {
      "approx_t": 44.0,
      "text": "Now turn it."
    },
    {
      "approx_t": 45.0,
      "text": "A front photograph hides..."
    },
    {
      "approx_t": 47.0,
      "text": "None of this means fuller is better."
    },
    {
      "approx_t": 50.0,
      "text": "It means lips are load-bearing."
    },
    {
      "approx_t": 52.0,
      "text": "On many faces, less is the change."
    },
    {
      "approx_t": 54.0,
      "text": "Do it now."
    },
    {
      "approx_t": 55.0,
      "text": "Roll your lips inward and hold."
    },
    {
      "approx_t": 57.0,
      "text": "Watch your chin arrive."
    },
    {
      "approx_t": 59.0,
      "text": "You will not get that mouth."
    },
    {
      "approx_t": 61.0,
      "text": "See it on your own face first."
    },
    {
      "approx_t": 63.0,
      "text": "Preview, not a promise."
    },
    {
      "approx_t": 66.0,
      "text": "Search Refina AI."
    }
  ],
