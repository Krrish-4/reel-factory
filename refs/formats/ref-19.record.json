  "transcript": [
    {
      "approx_t": 0.0,
      "text": "If you have a round shaped face, your beard should make your face look longer by being shorter on the sides."
    },
    {
      "approx_t": 5.0,
      "text": "So go for a tapered beard, a ducktail, or a thick boxed beard."
    },
    {
      "approx_t": 9.0,
      "text": "But skip a big full beard or a lot of hair around your cheeks."
    },
    {
      "approx_t": 13.0,
      "text": "If you have a square shaped face, your jaw is already wide, so your beard needs to soften your jaw."
    },
    {
      "approx_t": 19.0,
      "text": "So go for a beardstache, a short tapered beard, a balbo, or a long boxed beard."
    },
    {
      "approx_t": 25.0,
      "text": "But avoid a very thick full beard."
    },
    {
      "approx_t": 27.0,
      "text": "And if you have an oval shaped face, you have the most freedom because your face is already balanced."
    },
    {
      "approx_t": 32.0,
      "text": "So go for a stubble, beardstache, full beard, Van Dyke, but mainly skip extreme versions."
    },
    {
      "approx_t": 40.0,
      "text": "Follow for more grooming tips."
    }
  ],
