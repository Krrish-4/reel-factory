  "transcript": [
    {
      "approx_t": 0,
      "text": "Think your nose is too big?"
    },
    {
      "approx_t": 1,
      "text": "Same face, same nose."
    },
    {
      "approx_t": 2,
      "text": "Same woman, twice."
    },
    {
      "approx_t": 3,
      "text": "Same nose, both photographs."
    },
    {
      "approx_t": 6,
      "text": "But it looks smaller in the second."
    },
    {
      "approx_t": 8,
      "text": "Her chin is what moved."
    },
    {
      "approx_t": 11,
      "text": "Here is every pixel that changed."
    },
    {
      "approx_t": 13,
      "text": "Almost none of it is on her nose."
    },
    {
      "approx_t": 15,
      "text": "Your eye doesn't measure features."
    },
    {
      "approx_t": 17,
      "text": "It compares them."
    },
    {
      "approx_t": 19,
      "text": "When the chin sits back, the nose stands out."
    },
    {
      "approx_t": 22,
      "text": "Your brain calls it a big nose."
    },
    {
      "approx_t": 24,
      "text": "Bring it forward and the nose has something to sit against."
    },
    {
      "approx_t": 27,
      "text": "It didn't shrink. The face caught up."
    },
    {
      "approx_t": 29,
      "text": "Try it right now."
    },
    {
      "approx_t": 30,
      "text": "Push your lower jaw forward."
    },
    {
      "approx_t": 31,
      "text": "Hold it there."
    },
    {
      "approx_t": 33,
      "text": "Watch your nose."
    },
    {
      "approx_t": 33,
      "text": "Your nose just got smaller. You didn't touch it."
    },
    {
      "approx_t": 35,
      "text": "The question was never which feature to fix."
    },
    {
      "approx_t": 38,
      "text": "It's what the whole face does when one thing moves."
    },
    {
      "approx_t": 43,
      "text": "See it on your own face first."
    },
    {
      "approx_t": 45,
      "text": "A preview, not a promise."
    },
    {
      "approx_t": 48,
      "text": "Search Refina AI."
    }
