    {
      "approx_t": 20,
      "track": "caption",
      "text": "One. The nose and the chin are read as one line."
    },
    {
      "approx_t": 21,
      "track": "label",
      "text": "NOSE"
    },
    {
      "approx_t": 24,
      "track": "label",
      "text": "CHIN"
    },
    {
      "approx_t": 24,
      "track": "caption",
      "text": "A chin that sits back leaves the nose out in front."
    },
    {
      "approx_t": 29,
      "track": "caption",
      "text": "Bring the chin forward and the nose settles back."
    },
    {
      "approx_t": 32,
      "track": "caption",
      "text": "Same nose. Every time."
    },
    {
      "approx_t": 34,
      "track": "headline",
