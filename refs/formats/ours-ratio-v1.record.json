    {
      "approx_t": 43,
      "track": "caption",
      "text": "Lift the hood and the eye reads open."
    },
    {
      "approx_t": 47,
      "track": "caption",
      "text": "The eye didn't grow. The cover moved."
    },
    {
      "approx_t": 51,
      "track": "headline",
      "text": "3. The thirds"
