      "track": "caption",
      "text": "Almost none of them are on the nose."
    },
    {
      "approx_t": 18,
      "track": "caption",
      "text": "It didn't shrink. The face caught up."
    },
    {
      "approx_t": 20,
      "track": "headline",
      "text": "1. Nose and chin"
