    {
      "approx_t": 22,
      "track": "label",
      "text": "NOSE BASE TO LIP EDGE, MEASURED"
    },
    {
      "approx_t": 24,
      "track": "caption",
      "text": "Full lips make it short. Thin lips, long."
    },
    {
      "approx_t": 27,
      "track": "caption",
      "text": "The nose isn't what changed."
    },
    {
      "approx_t": 30,
      "track": "headline",
