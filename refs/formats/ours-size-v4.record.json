      "track": "headline",
      "text": "It was never about size"
    },
    {
      "approx_t": 1,
      "track": "label",
      "text": "PHOTOGRAPH, UNMODIFIED"
    },
    {
      "approx_t": 1,
      "track": "caption",
      "text": "This is the mouth you're picturing."
    },
    {
      "approx_t": 3,
      "track": "caption",
      "text": "And it was never about size."
    },
    {
      "approx_t": 5,
      "track": "caption",
      "text": "Lips are not a feature."
    },
    {
      "approx_t": 6,
      "track": "headline",
      "text": "The lower third is read from here"
    },
    {
      "approx_t": 7,
      "track": "label",
      "text": "NOSE BASE"
    },
    {
      "approx_t": 7,
      "track": "label",
      "text": "LIP EDGE"
    },
    {
      "approx_t": 7,
      "track": "label",
      "text": "CHIN"
    },
    {
      "approx_t": 8,
      "track": "caption",
      "text": "They are the line the lower face is measured from."
    },
    {
      "approx_t": 13,
      "track": "headline",
      "text": "Your eye reads gaps"
    },
    {
      "approx_t": 13,
      "track": "label",
      "text": "THE GAP, NOT THE PART"
    },
    {
      "approx_t": 14,
      "track": "caption",
      "text": "Your eye never measures a feature alone."
    },
    {
      "approx_t": 15,
      "track": "caption",
      "text": "It measures the gaps around it."
    },
    {
      "approx_t": 18,
      "track": "caption",
      "text": "Move the lip line and every gap moves."
    },
    {
      "approx_t": 20,
      "track": "headline",
      "text": "1. The gap above"
    },
    {
      "approx_t": 22,
      "track": "label",
      "text": "THIN"
    },
    {
      "approx_t": 22,
      "track": "label",
