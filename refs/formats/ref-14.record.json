      "approx_t": 0.0,
      "text": "Do you have a masculine or feminine chin?"
    },
    {
      "approx_t": 2.0,
      "text": "Here's a quick rough test for you to tell."
    },
    {
      "approx_t": 4.0,
      "text": "Imagine two sets of parallel lines coming straight down from the corners of your nose and the corners of your mouth."
    },
    {
      "approx_t": 10.0,
      "text": "If your chin is about the same width as your mouth, you probably have a masculine chin."
    },
    {
      "approx_t": 14.0,
      "text": "If it's about the same width as your nose, you probably have a feminine chin."
    },
    {
      "approx_t": 18.0,
      "text": "If you want us to analyze your face, click the link in bio at qoves.com."
    }
